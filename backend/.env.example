# ============================================================
# AI Interview Preparation System - Backend Environment Config
# ============================================================
# Copy this file to .env and fill in your values

# --- App Settings ---
APP_NAME="AI Interview Prep System"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="your-super-secret-key-change-this-in-production-minimum-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# For development (SQLite - no setup needed):
DATABASE_URL="sqlite:///./interview_prep.db"
# For production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/interview_prep_db"

# --- OpenAI ---
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Use Mock AI (set true if no OpenAI key) ---
USE_MOCK_AI=true

# --- ChromaDB ---
CHROMA_PERSIST_DIR="./chroma_db"

# --- File Storage (local for dev) ---
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# --- CORS ---
FRONTEND_URL="http://localhost:3000"

# --- Speech ---
WHISPER_MODEL="base"
